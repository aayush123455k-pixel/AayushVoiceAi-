<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Aayush Voice AI"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mic dabaiye aur command boliye"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnMic"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="#4F46E5"
        android:text="SPEAK"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#1E293B"
        android:padding="16dp"
        android:text="Aapki aawaz yahan dikhegi..."
        android:textColor="#38BDF8"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1E293B"
        android:padding="16dp"
        android:text="Assistant ka jawab yahan dikhega..."
        android:textColor="#E2E8F0"
        android:textSize="15sp" />

</LinearLayout>
